%article
  .header
    %h3.d-inline= blog.title
    .float-end.mt-1
      - if blog.pin?
        = t("blog.icon.pin")
      - else
        = blog.created_at.strftime("%b %e %Y")
  .body
    ~ blog.summary_html
  - editable = can?(:edit, blog)
  - if blog.story.present? || blog.user.present? || editable
    .footer.small
      - if blog.story.present?
        = link_to t("blog.more"), blog
      .float-end.mt-1
        - if editable
          = link_to t("edit"), edit_blog_path(blog), class: "btn btn-primary btn-sm py-0"
        - elsif blog.user.present?
          = blog.user.handle
